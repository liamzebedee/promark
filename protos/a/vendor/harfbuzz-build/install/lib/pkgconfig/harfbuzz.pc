prefix=/Users/liamz/Documents/Ongoing projects/mdeditor/protos/a/harfbuzz-build/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: harfbuzz
Description: HarfBuzz text shaping library
Version: 12.3.0

Libs: -L${libdir} -lharfbuzz
Libs.private: -lm -pthread -framework ApplicationServices
Requires.private: freetype2 >= 12.0.6
Cflags: -I${includedir}/harfbuzz
